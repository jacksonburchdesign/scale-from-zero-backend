rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /projects/{projectId}/{allPaths=**} {
      allow read: if true;
      // Allow authenticated users to upload to projects
      // (In a more complex app, we'd verify they are a member, but storage rules
      // have limited firestore access. For MVP, auth is sufficient if the path is obscure.)
      allow write: if request.auth != null;
    }
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
