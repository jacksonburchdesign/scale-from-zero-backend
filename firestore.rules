rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isMember(projectData) {
      return isAuthenticated() && (
        projectData.ownerId == request.auth.uid || 
        projectData.members[request.auth.uid] != null
      );
    }
    function isOwner(projectData) {
      return isAuthenticated() && (
        projectData.ownerId == request.auth.uid || 
        projectData.members[request.auth.uid] == 'owner'
      );
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /projects/{projectId} {
      // Public profiles: anyone can read project details
      allow read: if true;
      
      // Creating requires setting yourself as owner
      allow create: if isAuthenticated() && 
        request.resource.data.members[request.auth.uid] == 'owner';
        
      // Only owners can update project settings
      allow update, delete: if isOwner(resource.data);

      match /changelogs/{changelogId} {
        // Public profiles: anyone can read changelogs
        allow read: if true;
        
        // Members can create/edit changelogs (e.g. hitting publish)
        allow write: if isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
      }
    }

    match /invites/{inviteId} {
      // Only cloud functions manage invites in MVP, so we can lock this down
      allow read, write: if false; 
    }
  }
}
